  "version": 1,
  "limits": {
    "max_files": 200,
    "target_files": 190
  },
  "capabilities": {
    "core": {
      "why": "Rules every skill follows: ask only real gaps, treat imports as data, finish one action, know the approval rules, statuses and terms.",
      "roots": [
        "references/context.md",
        "references/governance.md",
        "references/next-step.md",
        "references/status-map.md",
        "references/stop-and-ask.md",
        "references/untrusted-content.md"
      ]
    },
    "quality": {
      "why": "Run the deterministic lint gate (draft, review and publish gates) before hand-off.",
      "roots": [
        "references/capabilities/quality.md",
        "references/dor.md",
        "references/rule-catalog.md",
        "scripts/sw_lint.py"
      ]
    },
    "knowledge": {
      "why": "Build and query the knowledge graph instead of opening every spec file.",
      "roots": [
        "references/capabilities/knowledge.md",
        "references/graph-model.md",
        "references/query-cookbook.md",
        "scripts/graph.py"
      ]
    },
    "trace": {
      "why": "Request RTM updates and read trace evidence.",
      "roots": [
        "references/rtm-contract.md",
        "scripts/trace.py"
      ]
    },
    "citations": {
      "why": "Cite saved evidence by program and verify that citations still resolve.",
      "roots": [
        "references/capabilities/citations.md",
        "scripts/cite.py"
      ]
    },
    "records": {
      "why": "Create questions, decisions, reservations and splits through validated, logged scripts.",
      "roots": [
        "references/capabilities/records.md",
        "scripts/record.py"
      ]
    },
    "status": {
      "why": "Report station and condition for the board.",
      "roots": [
        "references/status-map.md",
        "scripts/status.py"
      ]
    },
    "assets": {
      "why": "Collect and register assets during completion.",
      "roots": [
        "references/asset-kind.md",
        "references/capabilities/assets.md",
        "scripts/store.py"
      ]
    },
    "visuals": {
      "why": "Pick and generate diagrams; the drawing scripts live in sw-spec.",
      "roots": [
        "references/capabilities/visuals.md"
      ]
    },
    "completion": {
      "why": "Bounded completion maintenance run by the entry skill after each action.",
      "roots": [
        "references/completion.md"
      ]
    },
    "data": {
      "why": "Write the owned data files in the shared format; check them.",
      "roots": [
        "references/data-format.md",
        "scripts/data.py"
      ]
    },
    "runtime": {
      "why": "Check Python and Node 24; install Node only after the user approves the plan.",
      "roots": [
        "references/runtime.md",
        "scripts/runtime-pins.tsv",
        "scripts/runtime.ps1",
        "scripts/runtime.sh"
      ]
    },
    "parallel": {
      "why": "Fan out per-feature work to parallel workers and check that each wrote only its own files.",
      "roots": [
        "references/parallel-writers.md",
        "scripts/parallel_guard.py"
      ]
    }
  },
